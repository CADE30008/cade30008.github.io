{
  "name": "cade30008-course",
  "version": "0.1.0",
  "private": true,
  "description": "CADE30008 Flight Dynamics & Control: lectures, handouts and example sheets",
  "type": "module",
  "scripts": {
    "slides": "node scripts/build-slides.mjs",
    "check": "node scripts/check-sync.mjs",
    "sync:accept": "node scripts/check-sync.mjs --accept",
    "site": ".venv/bin/zensical build --clean",
    "serve": ".venv/bin/zensical serve",
    "pdf": "node scripts/build-pdfs.mjs",
    "build": "npm run slides && npm run site && npm run pdf && npm run check",
    "models": ".venv/bin/python models/pitch.py > /dev/null && .venv/bin/python models/example_sheet.py > /dev/null && .venv/bin/python models/compare.py",
    "stills": "node scripts/capture-stills.mjs",
    "test": "node scripts/test-applets.mjs && npm run check"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.5.1",
    "marp-template": "file:../flightlab-marp-template"
  }
}
