          },
          "parts": [
            {
              "type": "numberentry",
              "marks": 1,
              "showCorrectAnswer": true,
              "showFeedbackIcon": true,
              "prompt": "<p>final value</p>",
              "minValue": "1.49",
              "maxValue": "1.51",
              "correctAnswerFraction": false,
              "allowFractions": false,
              "mustBeReduced": false,
              "notationStyles": [
                "plain",
