      "questions": [
        {
          "name": "Alternative answers probe",
          "statement": "<p>A damping ratio question, stripped to nothing. The part below accepts 0.4. Three wrong values are set up as alternative answers.</p>",
          "advice": "",
          "parts": [
            {
              "type": "numberentry",
              "marks": 1,
              "prompt": "<p>Enter <strong>0.4</strong> (right), or one of the wrong values <strong>0.16</strong>, <strong>0.8</strong>, <strong>2</strong>. Watch which message appears, <em>and what score you are given</em>.</p>",
              "minValue": "0.39",
